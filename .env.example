# Copy to .env and fill in values from your Melodify session.
# Never commit .env.

MELODIFY_AUTHORIZATION=
MELODIFY_USER_ID=
MELODIFY_DEVICE_ID=
MELODIFY_DEVICE_TOKEN=

# Optional overrides
# MELODIFY_API_BASE=https://melodify.pw/api/desktop/v9
# MELODIFY_APP_VERSION=9.1.3
# MELODIFY_PWA_VERSION=9.2.6 Desktop
# MELODIFY_PLATFORM=Linux-Desktop
# MELODIFY_DEVICE_NAME=Linux Desktop
# On macOS defaults become Mac-Desktop / Mac Desktop when unset.
# MELODIFY_STREAM_QUALITY=320
# MELODIFY_PLAYER=mpv
# MELODIFY_MPRIS=1
# MELODIFY_NOWPLAYING=1
