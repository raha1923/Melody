# Optional / legacy. Prefer: melodify login
# Env vars override ~/.local/share/melodify/session.json when set.
# Never commit .env.

# MELODIFY_AUTHORIZATION=
# MELODIFY_USER_ID=
# MELODIFY_DEVICE_ID=
# MELODIFY_DEVICE_TOKEN=

# Optional overrides
# MELODIFY_API_BASE=https://melodify.pw/api/desktop/v9
# MELODIFY_APP_VERSION=9.1.3
# MELODIFY_PWA_VERSION=9.2.6 Desktop
# MELODIFY_PLATFORM=Linux-Desktop
# On macOS the PWA uses "Mac OS-Desktop" (with a space) and device-name like
# "Mac OS 14.0 (os)" — those are the automatic defaults.
# MELODIFY_STREAM_QUALITY=320
# MELODIFY_PLAYER=mpv
# MELODIFY_MPRIS=1
# MELODIFY_NOWPLAYING=1
